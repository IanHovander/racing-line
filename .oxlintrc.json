{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "rules": {
    "typescript/no-explicit-any": "off"
  },
  "ignorePatterns": ["dist/**", "public/vendor/**", "src/vendor/**", "src/ui/posters.ts"]
}
