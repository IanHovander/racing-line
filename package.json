{
  "name": "racing-line",
  "version": "16.1.0",
  "private": true,
  "description": "Formula-style racing from a helicopter's view: a browser game in TypeScript and canvas 2D.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --dev",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "serve": "node scripts/serve.mjs",
    "test": "playwright test",
    "check": "npm run fmt:check && npm run lint && npm run typecheck && npm run build && npm test",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright": "^1.63.0",
    "typescript": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
