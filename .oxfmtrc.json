{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 110,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "avoid",
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist/**",
    "public/vendor/**",
    "public/dynlines.json",
    "src/vendor/**",
    "src/ui/posters.ts",
    "package-lock.json",
    "tools/.lines/**",
    "tools/.rollout/**",
    "tools/.cache.json"
  ]
}
